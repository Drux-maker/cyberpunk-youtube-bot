# ─── Environment ──────────────────────────────────────────────────────────────
ENV=development
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./cyberpunk_bot.db
REDIS_URL=redis://localhost:6379/0

# ─── OpenAI — solo para SEO (títulos, descripciones, tags) ───────────────────
# Opcional: sin esta key el SEO usa fallback con plantillas locales
# Coste: ~0.01 EUR por vídeo con gpt-4o-mini
OPENAI_API_KEY=

# ─── YouTube — necesario solo para subir vídeos ───────────────────────────────
# Obtener en: console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CHANNEL_NAME=CyberpunkAI Music

# ─── Scheduler ────────────────────────────────────────────────────────────────
VIDEOS_PER_DAY=2
